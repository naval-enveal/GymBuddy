# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/gymbuddy

# Auth / JWT. Required in production (boot fails if unset there). Use long,
# random, distinct values for each secret.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Gemini API (M9 AI layer). SERVER-SIDE ONLY — the app never holds this key.
# AI plan generation returns 503 when GEMINI_API_KEY is unset. Free tier:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
