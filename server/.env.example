# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/gymbuddy

# Auth / JWT. Required in production (boot fails if unset there). Use long,
# random, distinct values for each secret.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Claude API (M9 AI layer). SERVER-SIDE ONLY — the app never holds this key.
# AI plan generation returns 503 when ANTHROPIC_API_KEY is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
